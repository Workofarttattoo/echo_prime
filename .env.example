# ECH0-PRIME Environment Variables
# Copy to .env and fill in values

# Phase (1=validation, 2=capability dev, 3=AGI integration)
ECH0_PHASE=2

# Lightweight mode (1=skip heavy models, 0=full)
ECH0_LIGHTWEIGHT=0

# LLM Provider
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud AI (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Voice (optional)
ELEVENLABS_API_KEY=

# Dashboard
DASHBOARD_PORT=8000

# HuggingFace (for deployment)
HF_TOKEN=
