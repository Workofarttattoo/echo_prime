# ===========================================================================

# ── Core Settings ─────────────────────────────────────────────────────────
# Phase: 1 = validation, 2 = capability dev, 3 = AGI integration
ECH0_PHASE=2

# Lightweight mode: 1 = skip heavy models (good for testing), 0 = full
ECH0_LIGHTWEIGHT=0

# Application mode: orchestrator | gradio | dashboard
ECH0_MODE=orchestrator

# Dimension profile: full | balanced | lite
ECH0_DIM_PROFILE=lite

# Project root override (auto-detected if not set)
# ECH0_ROOT=/app

# ── LLM Provider ─────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Cloud AI APIs (optional — set the ones you use) ──────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=

# ── Voice / Audio (optional) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Vector Database (optional) ───────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# ── Database (optional) ──────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# ── Dashboard / API Ports ─────────────────────────────────────────────────
DASHBOARD_PORT=8000
GRADIO_PORT=7860
REDIS_PORT=6379

# ── HuggingFace ──────────────────────────────────────────────────────────
HF_TOKEN=
HF_SPACE_MODEL=meta-llama/Meta-Llama-3.1-34B-Instruct-Turbo

# ── External Services ────────────────────────────────────────────────────
QULAB_PATH=external/QuLabInfinite
ECH0_TRAINING_DATA=ech0_training_data

# ── License ──────────────────────────────────────────────────────────────
# REQUIRED in production — set to a strong random secret
ECH0_LICENSE_SECRET=

# ── Deployment (Bluehost FTP — for n3ph1l1m website) ─────────────────────
BLUEHOST_FTP_HOST=
BLUEHOST_FTP_USER=
BLUEHOST_FTP_PASS=
BLUEHOST_FTP_DIR=/public_html
